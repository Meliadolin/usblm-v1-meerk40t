;; WinUSB-LASER.INF - Install WinUSB for BJJCZ Laser Mark Control Board V1
;; Uses inbox WinUSB driver (signed by Microsoft)

[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
DriverVer=07/27/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_9588&PID_9990
%DeviceName% = USB_Install, USB\VID_9588&PID_9999

[USB_Install]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install.HW]
AddReg=WinUSB_AddReg

[WinUSB_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{b1c2d3e4-5f6a-4b7c-8d9e-0f1a2b3c4d5e}"

[Strings]
ManufacturerName="BJJCZ Laser Control"
DeviceName="Laser Mark Control Board V1 [WinUSB]"
